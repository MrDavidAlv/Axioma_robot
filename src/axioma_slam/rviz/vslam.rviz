Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /RobotModel1
    - /ZED 2i point cloud1
    Splitter Ratio: 0.5
  Tree Height: 640
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.4
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 30
    Reference Frame: odom
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: true
    Name: RobotModel
    Visual Enabled: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: false
      base_footprint:
        Value: true
      base_link:
        Value: true
      imu_link:
        Value: true
      odom:
        Value: true
      zed2i_camera_center:
        Value: true
      zed2i_left_camera_frame_optical:
        Value: true
    Marker Scale: 0.4
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Tree Height: 200
    Update Interval: 0
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 90; 40
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: LiDAR scan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.02
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 4
      Min Value: 0
      Value: false
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: AxisColor
    Decay Time: 0.0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: RTAB-Map cloud (map)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.02
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /cloud_map
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/Map
    Name: RTAB-Map occupancy grid
    Enabled: true
    Alpha: 0.6
    Color Scheme: map
    Draw Behind: true
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: ZED 2i left image
    Normalize Range: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /zed2i/image
    Value: true
  - Class: rviz_default_plugins/Odometry
    Name: Visual odometry
    Enabled: true
    Covariance:
      Value: false
    Keep: 300
    Position Tolerance: 0.05
    Angle Tolerance: 0.05
    Shape:
      Alpha: 1.0
      Axes Length: 0.15
      Axes Radius: 0.02
      Color: 255; 85; 0
      Head Length: 0.06
      Head Radius: 0.03
      Shaft Length: 0.1
      Shaft Radius: 0.015
      Value: Axes
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /vslam/odom
    Value: true
  - Angle Tolerance: 0.05
    Class: rviz_default_plugins/Odometry
    Covariance:
      Orientation:
        Alpha: 0.5
        Color: 255; 255; 127
        Color Style: Unique
        Frame: Local
        Offset: 1
        Scale: 1
        Value: false
      Position:
        Alpha: 0.3
        Color: 204; 51; 204
        Scale: 1
        Value: false
      Value: false
    Enabled: true
    Keep: 300
    Name: EKF pose (comparison)
    Position Tolerance: 0.05
    Shape:
      Alpha: 1
      Axes Length: 0.25
      Axes Radius: 0.02
      Color: 60; 200; 90
      Head Length: 0.08
      Head Radius: 0.05
      Shaft Length: 0.2
      Shaft Radius: 0.02
      Value: Axes
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /odometry/filtered
    Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: base_footprint
      Value: Orbit (rviz)
      Yaw: 2.9
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
  X: 60
  Y: 60
