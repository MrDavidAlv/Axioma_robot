<sdf version='1.9'>
  <model name='axioma_v2'>

    <link name='base_link'>

      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.1135</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.426</iyy>
          <iyz>0</iyz>
          <izz>0.5205</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://axioma_v2/meshes/collision/chasis.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name='base_link_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://axioma_v2/meshes/visual/chasis.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.05 0.1 0.35 1</diffuse>
          <ambient>0.02 0.05 0.15 1</ambient>
          <specular>0.3 0.3 0.4 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ==================== WHEEL 1 (front-left) ==================== -->
    <joint name='base_to_wheel1' type='revolute'>
      <pose relative_to='base_link'>0.06442 0.07385 0.04068 3.141516 -0 3.141516</pose>
      <parent>base_link</parent>
      <child>wheel_1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>
    <link name='wheel_1'>
      <pose relative_to='base_to_wheel1'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0029</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0029</iyy>
          <iyz>0</iyz>
          <izz>0.0056</izz>
        </inertia>
      </inertial>
      <collision name='wheel_1_collision'>
        <pose>0 0.02 0 -1.5707 -0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0381</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <!-- Anisotropic friction: fdir1 is the cylinder axis, i.e. the
                 wheel axle, which does not rotate as the wheel spins. So mu is
                 the sideways (scrub) coefficient and mu2 the rolling one.
                 Leaving both at 1.0 made this 4-wheel skid-steer resist yaw so
                 hard it turned only ~65% of the commanded rate while the plugin
                 integrated 100% of it, which wrecked odometry, SLAM and AMCL.
                 Letting the wheels scrub sideways makes it behave like a true
                 differential drive. Verified against the Gazebo ground-truth
                 pose from 0.1 to 1.0 rad/s. -->
            <ode>
              <fdir1>0 0 1</fdir1>
              <mu>0.05</mu>
              <mu2>1.0</mu2>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='wheel_1_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://axioma_v2/meshes/visual/llanta.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <ambient>0.05 0.05 0.05 1</ambient>
          <specular>0.2 0.2 0.2 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ==================== WHEEL 2 (rear-left) ==================== -->
    <joint name='base_to_wheel2' type='revolute'>
      <pose relative_to='base_link'>-0.071224 0.07385 0.04068 3.141516 -0 3.141516</pose>
      <parent>base_link</parent>
      <child>wheel_2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>
    <link name='wheel_2'>
      <pose relative_to='base_to_wheel2'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0029</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0029</iyy>
          <iyz>0</iyz>
          <izz>0.0056</izz>
        </inertia>
      </inertial>
      <collision name='wheel_2_collision'>
        <pose>0 0.02 0 -1.5707 -0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0381</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <fdir1>0 0 1</fdir1>
              <mu>0.05</mu>
              <mu2>1.0</mu2>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='wheel_2_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://axioma_v2/meshes/visual/llanta.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <ambient>0.05 0.05 0.05 1</ambient>
          <specular>0.2 0.2 0.2 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ==================== WHEEL 3 (rear-right) ==================== -->
    <joint name='base_to_wheel3' type='revolute'>
      <pose relative_to='base_link'>-0.071224 -0.0625 0.04068 0 0 3.141592</pose>
      <parent>base_link</parent>
      <child>wheel_3</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>
    <link name='wheel_3'>
      <pose relative_to='base_to_wheel3'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0029</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0029</iyy>
          <iyz>0</iyz>
          <izz>0.0056</izz>
        </inertia>
      </inertial>
      <collision name='wheel_3_collision'>
        <pose>0 0.02 0 -1.5707 -0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0381</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <fdir1>0 0 1</fdir1>
              <mu>0.05</mu>
              <mu2>1.0</mu2>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='wheel_3_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://axioma_v2/meshes/visual/llanta.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <ambient>0.05 0.05 0.05 1</ambient>
          <specular>0.2 0.2 0.2 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ==================== WHEEL 4 (front-right) ==================== -->
    <joint name='base_to_wheel4' type='revolute'>
      <pose relative_to='base_link'>0.064423 -0.0625 0.04068 0 0 3.141592</pose>
      <parent>base_link</parent>
      <child>wheel_4</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>
    <link name='wheel_4'>
      <pose relative_to='base_to_wheel4'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0029</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0029</iyy>
          <iyz>0</iyz>
          <izz>0.0056</izz>
        </inertia>
      </inertial>
      <collision name='wheel_4_collision'>
        <pose>0 0.02 0 -1.5707 -0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0381</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <fdir1>0 0 1</fdir1>
              <mu>0.05</mu>
              <mu2>1.0</mu2>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.01</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='wheel_4_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://axioma_v2/meshes/visual/llanta.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <ambient>0.05 0.05 0.05 1</ambient>
          <specular>0.2 0.2 0.2 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ==================== LIDAR SENSOR ==================== -->
    <link name="base_scan">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.001</iyy>
          <iyz>0.000</iyz>
          <izz>0.001</izz>
        </inertia>
        <mass>0.125</mass>
      </inertial>
      <collision name="lidar_sensor_collision">
        <geometry>
          <cylinder>
            <radius>0.031</radius>
            <length>0.041</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="lidar_sensor_visual">
        <geometry>
          <cylinder>
            <radius>0.031</radius>
            <length>0.041</length>
          </cylinder>
        </geometry>
      </visual>
      <!-- YDLIDAR X3 PRO (the unit is marked X3-YB-1).
           Triangulation head, 0.12-8 m, 40 klux ambient light rejection. The
           ranging rate is fixed at 4 kHz and the motor speed is adjustable
           between 5 and 10 Hz, so angular resolution falls out of the two:

               samples per revolution = 4000 / scan frequency

                 5 Hz -> 800 samples, 0.450 deg
                 7 Hz -> 571 samples, 0.630 deg
                10 Hz -> 400 samples, 0.900 deg   <- modelled here

           10 Hz is what axioma_bringup/config/ydlidar_x3_pro.yaml asks the real
           head for, so the simulated scan has the same density as the robot's.

           If ydlidar_ros2_driver runs the real head at a different frequency,
           change <update_rate> and <samples> together, otherwise the simulated
           scan is denser or sparser than the real one. The driver's range_max
           default of 12 m is a software clamp, not the sensor.

           Angles run from -pi so the simulated scan is laid out the same way
           the driver publishes it. -->
      <sensor name="ydlidar_x3_pro" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>base_scan</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.125885</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.120000</min>
            <max>8.0</max>
            <resolution>0.015000</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.015</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_scan</child>
    </joint>

    <!-- ==================== IMU ==================== -->

    <!-- The frame imu_link has existed in axioma.urdf.xacro for a while with
         nothing publishing on it. This is the sensor that fills it.

         Placement matches the URDF exactly: on the chassis centreline, 0.12 m
         above base_link. With no horizontal lever arm to the yaw axis, a turn
         in place produces yaw rate and no centripetal acceleration, so the EKF
         does not have to model one.

         Noise model: a consumer MEMS unit of the MPU-6050 class, which is what
         a robot this size is realistically fitted with. The numbers come from
         that datasheet's spectral densities integrated over a 100 Hz bandwidth:
         gyro 0.005 dps/sqrt(Hz) -> 8.7e-4 rad/s, accel 400 ug/sqrt(Hz) ->
         3.9e-2 m/s^2. The bias terms are the usual Gazebo turn-on-bias figures.

         THIS IS AN ASSUMPTION, not a measurement of the part on the robot. If
         the real IMU turns out to be a different class of device, these values
         and the matching imu0 covariances in axioma_perception/config/*.yaml
         have to move together — the EKF weights the IMU against wheel odometry
         using exactly these numbers, so getting them wrong quietly biases the
         fused roll and pitch rather than producing an obvious failure.

         100 Hz because that is what the EKF runs its prediction step at; a
         faster IMU would just be decimated, a slower one would starve it. -->
    <link name="imu_link">
      <pose>0 0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="axioma_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>8.7e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-7</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>8.7e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-7</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>8.7e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-7</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>3.9e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>3.9e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>3.9e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- ==================== ZED 2i ==================== -->

    <!-- Stereo depth camera on the front face. Pose, mass and geometry are the
         same ones axioma.urdf.xacro derives from the zed2i macro, restated here
         because Gazebo simulates this file and not the URDF: the link centre is
         the camera case centre at (0.098, 0, 0.115) in base_link, and the mesh
         sits 10 mm behind it because the URDF measures from the tripod screw.

         166 g at 98 mm forward and 115 mm up is a real change to a 5 kg robot:
         it moves the centre of mass forward and raises it. That is the point of
         giving the camera its own link with its own inertia instead of ignoring
         it — the tipping behaviour on the ramp in the terrain world depends on
         it, and pretending the camera is massless would flatter the result.

         What this sensor is NOT: the source of the EKF's pose. On the real
         robot that comes from the ZED SDK's positional tracking, which runs on
         the GPU inside the camera driver and has no equivalent in Gazebo. In
         simulation the EKF falls back to wheel odometry for position and takes
         only roll and pitch from the IMU — see axioma_perception/config/, which
         carries one config per case and documents the split. This sensor exists
         so that the simulated robot has the camera the URDF says it has, and so
         depth and point cloud can be inspected in RViz.

         Optics: the 2.1 mm lens is 110 deg horizontal, and its depth range is
         0.3-20 m. Gazebo renders a pinhole, so a 110 deg horizontal FOV at 16:9
         comes out at about 77 deg vertical against the real camera's 70 deg —
         the real lens is not a pinhole and the discrepancy is not worth faking.

         640x360 at 15 Hz, not the HD720 at 30 Hz the real camera runs. The
         aspect ratio and the FOV are what matter for geometry; the extra pixels
         only cost GPU time in a scene that already renders a lidar. -->
    <link name="zed2i_camera_center">
      <pose>0.098 0 0.115 0 0 0</pose>
      <inertial>
        <mass>0.166</mass>
        <inertia>
          <ixx>0.000438</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000039</iyy>
          <iyz>0</iyz>
          <izz>0.000451</izz>
        </inertia>
      </inertial>
      <collision name="zed2i_collision">
        <pose>-0.01 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0431 0.1753 0.0303</size>
          </box>
        </geometry>
      </collision>
      <visual name="zed2i_visual">
        <pose>-0.01 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://axioma_v2/meshes/visual/zed2i.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <ambient>0.08 0.08 0.08 1</ambient>
          <specular>0.3 0.3 0.3 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <!-- Posed at the left eye, because that is the frame the ZED SDK
           expresses depth, point cloud and tracking in. Relative to this link
           that is (-0.01, +0.06, 0): half the 120 mm stereo baseline to the
           left, and the 10 mm optical offset back.

           gz_frame_id names the *optical* frame, not this one. Gazebo poses a
           camera x-forward while every ROS image consumer expects z-forward,
           and the URDF already publishes the -90/0/-90 rotation between the
           two. Stamping the images with the optical frame is what makes the
           point cloud land in the right place in RViz instead of lying on its
           side, rotated 90 degrees. -->
      <sensor name="zed2i" type="rgbd_camera">
        <pose>-0.01 0.06 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>zed2i</topic>
        <gz_frame_id>zed2i_left_camera_frame_optical</gz_frame_id>
        <camera>
          <horizontal_fov>1.919862</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>20.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.3</near>
              <far>20.0</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <joint name="zed2i_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>zed2i_camera_center</child>
    </joint>

    <!-- ==================== GZ-SIM PLUGINS ==================== -->

    <!-- Differential drive (skid-steer 4WD) -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>base_to_wheel1</left_joint>
      <left_joint>base_to_wheel2</left_joint>
      <right_joint>base_to_wheel4</right_joint>
      <right_joint>base_to_wheel3</right_joint>
      <!-- Effective track, calibrated against the Gazebo ground-truth pose,
           not the 0.17635 m contact track. Residual yaw error is within
           3% from 0.1 to 1.0 rad/s and straight-line odometry is exact. -->
      <wheel_separation>0.1679</wheel_separation>
      <wheel_radius>0.0381</wheel_radius>
      <!-- max_wheel_torque and max_wheel_acceleration are Gazebo Classic tags.
           gz-sim-diff-drive-system silently ignores them, so the robot had no
           acceleration limit at all while DWB planned assuming one. These are
           the tags this plugin actually reads, set to the same envelope Nav2
           uses in nav2_params.yaml. -->
      <min_linear_velocity>-0.26</min_linear_velocity>
      <max_linear_velocity>0.26</max_linear_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_angular_acceleration>-3.2</min_angular_acceleration>
      <max_angular_acceleration>3.2</max_angular_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <tf_topic>tf</tf_topic>
    </plugin>

    <!-- Joint state publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <update_rate>20</update_rate>
      <joint_name>base_to_wheel1</joint_name>
      <joint_name>base_to_wheel2</joint_name>
      <joint_name>base_to_wheel3</joint_name>
      <joint_name>base_to_wheel4</joint_name>
    </plugin>

  </model>
</sdf>
