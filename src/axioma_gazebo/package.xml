<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>axioma_gazebo</name>
  <version>1.0.0</version>
  <description>Axioma Gz Sim simulation launch files for ROS2 Humble</description>
  <maintainer email="ing.marioalvarezvallejo@gmail.com">Mario David Alvarez Vallejo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <!-- point_cloud_xyzrgb: reprojects the ZED depth image into /zed2i/points.
       Gazebo's own cloud cannot be bridged with a correct frame - see the
       sensor block in models/axioma_v2/model.sdf. -->
  <depend>rtabmap_util</depend>
  <depend>robot_state_publisher</depend>
  <depend>axioma_description</depend>
  <depend>axioma_perception</depend>
  <depend>axioma_teleop_gui</depend>
  <depend>rviz2</depend>
  <depend>xacro</depend>
  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
