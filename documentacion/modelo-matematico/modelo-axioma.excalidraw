    },
    {
      "type": "text",
      "id": "nav2_architecture",
      "x": 60,
      "y": 705,
      "width": 480,
      "height": 150,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "ARQUITECTURA:\n\nGoal → NavFn Planner → Path global\n     → DWB Controller → Trayectoria local\n     → Velocity Smoother → /cmd_vel\n     → gz-sim-diff-drive-system → Ruedas",
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "section3"
      ],
      "seed": 29
    },
    {
      "type": "text",
      "id": "dwb_params",
      "x": 60,
      "y": 820,
      "width": 230,
      "height": 375,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "DWB LOCAL PLANNER:\n\nVelocidades:\n• max_vel_x: 0.26 m/s\n• max_vel_θ: 1.0 rad/s\n\nAceleración:\n• acc_lim_x: 1.0 m/s²\n• acc_lim_θ: 3.2 rad/s²\n\nMuestreo:\n• vx_samples: 20\n• vθ_samples: 20\n• vy_samples: 1  (sin eje y)\n• sim_time: 1.7 s",
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffe8cc",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "section3"
      ],
      "seed": 30
    },
    {
      "type": "text",
      "id": "amcl_params",
      "x": 310,
      "y": 820,
      "width": 230,
      "height": 375,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "AMCL LOCALIZACIÓN:\n\nModelo:\n• DifferentialMotionModel\n• alpha1-5: 0.05\n\nPartículas:\n• max: 5000   • min: 1000\n\nActualización:\n• min_d: 0.1 m  • min_a: 0.1 rad\n\nLiDAR:\n• max_beams: 120\n• laser_max_range: 8.0 m",
      "textAlign": "left",
